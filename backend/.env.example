APP_NAME=Wind Turbine AI Backend
APP_ENV=development
HOST=127.0.0.1
PORT=8000

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=wind_turbine_ai

JWT_SECRET_KEY=CHANGE_THIS_SECRET_KEY_FOR_PRODUCTION_USE_AT_LEAST_32_BYTES
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
ANALYSIS_RESULTS_DIR=storage/analysis_results

MODEL_ROOT=../trained_models
